actor BahonBoss : DoomImp 30000
{
    Health 200
    Radius 24
    Height 64
    Speed 10
    PainChance 256
    Monster
    +FLOORCLIP
    Tag "Bahon"

    States
    {
    Spawn:
        BAHO A 10 A_Look
        Loop
    See:
        BAHO A 3 A_Chase
        Loop
    Missile:
        BAHO A 8 A_FaceTarget
        BAHO A 6 A_TroopAttack
        Goto See
    Pain:
        BAHO A 0 A_JumpIfHealthLower(101, "Transform")
        BAHO A 3 A_Pain
        Goto See
    Transform:
        TNT1 A 0 A_PlaySound("misc/teleport")
        TNT1 A 0 A_SpawnItemEx("LeoBoss", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
        Stop
    Death:
        BAHO A 5 A_Scream
        BAHO A 5 A_NoBlocking
        BAHO A -1
        Stop
    }
}

